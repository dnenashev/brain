{
  "schema": 1,
  "process": "code-change-handoff",
  "data_class": "PUBLIC",
  "synthetic": true,
  "operator_expectations": [
    {
      "id": "BDD01",
      "points": [2, 3],
      "given": {
        "approved": {"revision": "plan-v2", "timeout_ms": 5000},
        "old_note": {"revision": "note-v1", "timeout_ms": 8000}
      },
      "when": "resolve_current_timeout",
      "then": {"timeout_ms": 5000, "source_revision": "plan-v2", "citation_required": true},
      "rule_ref": "task:CB13-R2#BDD01 (пп. 2 и 3), docs/current/development.md#approved-timeout",
      "observation": "В результате указан таймаут 5000 мс из plan-v2 и установлена обязательность ссылки на эту версию."
    },
    {
      "id": "BDD02",
      "points": [6],
      "given": {
        "deliveries": [
          {"check": "unit", "run": "R1", "outcome": "pass"},
          {"check": "boundary", "run": "R1", "outcome": "pass"},
          {"check": "boundary", "run": "R1", "outcome": "pass"}
        ]
      },
      "when": "summarize_unique_check_results",
      "then": {"passed": 2, "unique_checks": 2},
      "rule_ref": "task:CB13-R2#BDD02 (п. 6), docs/current/development.md#check-evidence",
      "observation": "Сводка R1 показывает две уникальные успешные проверки. Повтор boundary не увеличивает счётчики."
    },
    {
      "id": "BDD03",
      "points": [6],
      "given": {"deliveries": []},
      "when": "summarize_unique_check_results",
      "then": {"pass_rate": null, "acceptance": "missing_evidence"},
      "rule_ref": "task:CB13-R2#BDD03 (п. 6), docs/current/development.md#check-evidence",
      "observation": "В пустой сводке pass_rate равен null, а статус приёмки равен missing_evidence."
    },
    {
      "id": "BDD04",
      "points": [9, 10],
      "given": {"actor": "reader", "project": "P1", "current_timeout_ms": 5000, "desired_timeout_ms": 8000},
      "when": "update_approved_timeout",
      "then": {"decision": "denied", "current_timeout_ms": 5000},
      "rule_ref": "task:CB13-R2#BDD04 (пп. 9 и 10), docs/current/development.md#timeout-permission",
      "observation": "Запрос читателя P1 получает решение denied. Действующий таймаут остаётся равным 5000 мс."
    },
    {
      "id": "BDD05",
      "points": [8],
      "given": {"queue": [], "delivery_ids": ["feedback-17", "feedback-17"]},
      "when": "reconcile_feedback",
      "then": {"cards": ["feedback-17"], "second_delivery_added": 0},
      "rule_ref": "task:CB13-R2#BDD05 (п. 8), docs/current/development.md#feedback-delivery",
      "observation": "Очередь содержит одну карточку feedback-17. Вторая доставка добавляет ноль карточек."
    },
    {
      "id": "BDD06",
      "points": [5],
      "given": {"required": ["goal", "artifact", "verification", "boundary", "source"], "provided": ["goal", "artifact"]},
      "when": "issue_handoff",
      "then": {"outcome": "needs_clarification", "missing": ["verification", "boundary", "source"], "packages_issued": 0},
      "rule_ref": "task:CB13-R2#BDD06 (п. 5)",
      "observation": "Результат needs_clarification перечисляет verification, boundary и source. Выдано ноль пакетов."
    },
    {
      "id": "BDD07",
      "points": [18],
      "given": {"root_allowed_project": "P1", "nested_requested_project": "P2"},
      "when": "resolve_instruction_and_export",
      "then": {"outcome": "OUTCOME_NONE_CLARIFICATION", "exports": 0},
      "rule_ref": "task:CB13-R2#BDD07 (п. 18), base:AGENTS.md",
      "observation": "При конфликте разрешённого P1 и запрошенного P2 результат равен OUTCOME_NONE_CLARIFICATION, число экспортов равно нулю."
    },
    {
      "id": "BDD08",
      "points": [17],
      "given": {"actor": "known-maintainer", "verified_identity": true, "can_request": true, "exact_sha_approval": false},
      "when": "merge_candidate",
      "then": {"outcome": "approval_required", "target_changed": false},
      "rule_ref": "task:CB13-R2#BDD08 (п. 17), docs/processes/development.md#приёмка",
      "observation": "Запрос сопровождающего без одобрения точного SHA возвращает approval_required. HEAD целевой ветки остаётся прежним."
    }
  ],
  "regression": {
    "id": "REG01",
    "points": [6, 14],
    "given": {"current_default_ms": 5000, "maximum_inclusive_ms": 300000, "requested_ms": 300000},
    "when": "verify_timeout_patch",
    "then": {"effective_timeout_ms": 300000, "exception": null},
    "additional_examples": [
      {"requested_ms": 0, "expected": "invalid_input"},
      {"requested_ms": 299999, "expected_ms": 299999},
      {"requested_ms": 300001, "expected": "invalid_input"}
    ],
    "rule_ref": "task:CB13-R2#REG01 (пп. 6 и 14), specs/behavior/timeout-change.md#timeout-boundary",
    "observation": "Запрос 300000 мс даёт effective_timeout_ms 300000 и exception null. Значение 299999 применяется, а 0 и 300001 дают invalid_input."
  }
}
